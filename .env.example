PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/facebook_clone
JWT_SECRET=replace-with-a-long-random-secret
CLIENT_ORIGIN=http://localhost:5173
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM="Qavero <no-reply@example.com>"
STUN_URLS=stun:stun.l.google.com:19302
TURN_URLS=
# Use a coturn REST API shared secret; the secret itself is never sent to clients.
TURN_SHARED_SECRET=
TURN_TTL_SECONDS=3600
